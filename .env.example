# Instagram Graph API (Facebook Login) uzun ömürlü kullanıcı tokenı (60 gün geçerli)
IG_ACCESS_TOKEN=

# Kendi Instagram Business/Creator hesabının ID'si.
# Boş bırakırsan `python -m ig_snapshot check` komutu bulup buraya yazar.
IG_USER_ID=

# Token yenileme için (isteğe bağlı): Meta uygulamasının ID'si ve secret'ı
FB_APP_ID=
FB_APP_SECRET=

# Graph API sürümü
GRAPH_API_VERSION=v25.0

# Gönderiler yayınlandıktan sonra bu kadar gün ölçülmeye devam eder (sayfalama bu tarihe kadar iner)
TRACK_DAYS=45
# Hesap başına çekilecek en fazla gönderi (güvenlik sınırı; 50 gönderi = 1 API çağrısı)
MEDIA_MAX=600

# Hesaplar arası bekleme (saniye) - rate limit'e takılmamak için
REQUEST_PAUSE=1.5

# Telegram bildirimleri: @BotFather'dan bot tokenı; chat id'yi `telegram-test` komutu bulur
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Instagram tokenına bu kadar gün kalınca her gün uyarı gönder
TOKEN_WARN_DAYS=5
